# SoNoBot Configuration
# Create a copy of this file as .env and fill in your values

# SafeW Bot Token (Required)
BOT_TOKEN=your_bot_token_here

# Database Configuration
DB_PATH=sonobot.db

# Admin Configuration (comma-separated for multiple admins)
ADMIN_ID=123456789,987654321

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# BigModel AI Configuration (Optional)
BIGMODEL_API_KEY=your_api_key_here
BIGMODEL_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
BIGMODEL_MODEL=glm-4-flash
